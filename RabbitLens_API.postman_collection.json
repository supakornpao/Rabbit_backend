    {
      "name": "3. Scans & Media",
      "description": "Process paw scans, query scan results, stream media from MinIO, and test ML endpoints.",
      "item": [
        {
          "name": "13. Process Paw Scan - Back Left (POST /scans/)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns scan report and saves photo_id', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.photo_id).to.be.a('string');",
                  "    pm.expect(jsonData.rabbit_id).to.eql(pm.collectionVariables.get('rabbit_id'));",
                  "    pm.expect(jsonData.limb).to.eql('back_left');",
                  "    pm.expect(jsonData.classification).to.eql(2);",
                  "    pm.expect(jsonData.grade_title).to.include('Grade II');",
                  "    pm.collectionVariables.set('photo_id', jsonData.photo_id);",
                  "    pm.collectionVariables.set('media_path', jsonData.image_url);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "rabbit_id",
                  "value": "{{rabbit_id}}",
                  "type": "text"
                },
                {
                  "key": "limb",
                  "value": "back_left",
                  "type": "text"

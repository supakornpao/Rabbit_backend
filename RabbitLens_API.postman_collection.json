            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Exchange `refresh_token` for new tokens."
          },
          "response": []
        },
        {
          "name": "05. Get Current User (GET /auth/me)",
          "event": [

# Azure ML (From main.py)
AZURE_ML_ENDPOINT_URL="https://supakorn-fektp.japaneast.inference.ml.azure.com/score"
AZURE_ML_API_KEY="your_azure_ml_api_key_here"

# Authentication / JWT (For your auth/ folder)
SECRET_KEY="your_super_secret_jwt_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (For database.py)
# Format: postgresql://<username>:<password>@<host>:<port>/<db_name>
DATABASE_URL="postgresql://username:password@localhost:5433/fastapi_db"
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_secure_password_here
MINIO_BUCKET_NAME=rabbit-media
MINIO_USE_SSL=False